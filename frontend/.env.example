# ─── Database ────────────────────────────────
# Lấy tại: https://console.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ─── NextAuth.js ─────────────────────────────
NEXTAUTH_SECRET="tao-bang-lenh-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth (US 8.3 - Task 8.17) ───────
# Lấy tại: https://console.cloud.google.com/auth/clients
# Yêu cầu cấu hình trên Google Cloud Console:
# - Authorized JavaScript origins: http://localhost:3000
# - Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"

# ─── Backend API Connection ──────────────────
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:8000"
BACKEND_URL="http://127.0.0.1:8000"