# ==============================================================================
# SocraticKid Backend Environment Configuration (.env.example)
# ==============================================================================

# ─── Database (PostgreSQL / Neon Tech) ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ─── Google Gemini AI API Key ─────────────────────────────────────────────────
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# ─── Multi-Model Quota Pooling (US 10.4 - T10.4.6) ────────────────────────────
# Kiến trúc 6 phân hệ Gemini độc lập → 60 RPM & 6,000 RPD (tăng gấp 4 lần Free Tier)
# Mỗi model ID có bể hạn mức riêng: dùng 4 model khác nhau = 4 bể × 15 RPM = 60 RPM.
# Models đang hoạt động ổn định (xác nhận thực tế 11/2026):
#   gemini-3.8-flash      ✅ Chat Socratic (tốc độ cao, Socratic tốt nhất)
#   gemini-3.5-flash      ✅ Phân tích sâu (báo cáo phụ huynh)
#   gemini-3.1-flash-lite ✅ Phân loại & email (tiết kiệm token tới 60%)
#   gemini-3.5-flash-lite ✅ Flashcard & dự phòng (nhẹ, ổn định)
# ⚠️  KHÔNG dùng: gemini-1.5-flash (404 Not Found), gemini-2.5-flash (không available)
GEMINI_CHAT_MODEL="gemini-3.8-flash"
GEMINI_INSIGHT_MODEL="gemini-3.5-flash"
GEMINI_CLASSIFIER_MODEL="gemini-3.1-flash-lite"
GEMINI_EMAIL_MODEL="gemini-3.1-flash-lite"
GEMINI_FLASHCARD_MODEL="gemini-3.5-flash-lite"
GEMINI_BACKUP_MODEL="gemini-3.5-flash-lite"

# ─── JWT Authentication Secret ────────────────────────────────────────────────
SECRET_KEY="your-jwt-secret-key-at-least-32-chars"

# ─── Google OAuth 2.0 (US 8.3 - Task 8.17 / Task 8.19) ────────────────────────
# Phải trùng khớp với GOOGLE_CLIENT_ID của Frontend để xác thực token/ID token
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# ─── Upstash Redis (Session & Rate Limit) ──────────────────────────────────────
# Lấy tại: https://console.upstash.com
REDIS_URL="rediss://default:PASSWORD@HOST:6379"

# ─── Cloudinary Media Storage ─────────────────────────────────────────────────
# Lấy tại: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ─── Server & CORS Configuration ──────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
ENVIRONMENT="development"
