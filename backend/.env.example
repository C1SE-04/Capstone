# ==============================================================================
# SocraticKid Backend Environment Configuration (.env.example)
# ==============================================================================

# ─── Database (PostgreSQL / Neon Tech) ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ─── Google Gemini AI API Key ─────────────────────────────────────────────────
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# ─── JWT Authentication Secret ────────────────────────────────────────────────
SECRET_KEY="your-jwt-secret-key-at-least-32-chars"

# ─── Google OAuth 2.0 (US 8.3 - Task 8.17 / Task 8.19) ────────────────────────
# Phải trùng khớp với GOOGLE_CLIENT_ID của Frontend để xác thực token/ID token
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# ─── Upstash Redis (Session & Rate Limit) ──────────────────────────────────────
# Lấy tại: https://console.upstash.com
REDIS_URL="rediss://default:PASSWORD@HOST:6379"

# ─── Cloudinary Media Storage ─────────────────────────────────────────────────
# Lấy tại: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ─── Server & CORS Configuration ──────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
ENVIRONMENT="development"
